# ───────────────────────────────────────────────────────────────
# adobe2api-plus 环境变量模板
# 复制为 .env.development（本地）或 .env.production（部署）并填入实际值。
# 只列出必填项与 Roxy 浏览器；其余可调参数均可在管理后台「系统设置」中配置。
# ───────────────────────────────────────────────────────────────

# ── 数据库（必填）─────────────────────────────────────────────
# MySQL 连接串，必须 mysql: 协议且含库名（可 ?connectionLimit=10 追加连接池上限）
DATABASE_URL=mysql://user:password@127.0.0.1:3306/adobe

# ── 安全密钥（必填）───────────────────────────────────────────
# 会话签名密钥（≥32 字节）：openssl rand -hex 32
SESSION_SECRET=

# 凭据加密密钥（≥16 字节）：openssl rand -hex 16
ENCRYPTION_KEY=

# ── 管理员初始账号（可选，首次启动自动创建）───────────────────
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ── Roxy 浏览器（sherlockToken 自动铸造；留空则走手动输入 token）──
# 只需 API 地址 + API Key。workspaceId / dirId 由程序自动获取/创建，无需配置。
ROXYBROWSER_API_BASE=http://127.0.0.1:50001
ROXYBROWSER_API_TOKEN=
# 容器内访问宿主机 CDP 时设置（如部署在 Docker 内）
# ROXYBROWSER_CDP_HOST=host.docker.internal
# 宿主机 sherlock 铸造服务地址（配置后优先走该服务，无需直连 CDP）
# ROXYBROWSER_MINT_API=http://127.0.0.1:50002
