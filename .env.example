# ───────────────────────────────────────────────────────────────
# adobe2api-plus 环境变量模板
#
# Docker 部署：复制为 .env，填写所有必填变量后再启动。
# 模板不含可用凭据或共享默认值；留空会使 Compose 拒绝启动。
# 本地开发（非 Docker）：复制为 .env.development，并填写 DATABASE_URL。
# ───────────────────────────────────────────────────────────────

# ── 安全密钥（必填）──────────────────────────────────────────
# 至少 32 随机字节，例如 openssl rand -hex 32
SESSION_SECRET=

# 凭据加密密钥（必须是 32 字节，即 64 位 hex）：openssl rand -hex 32
ENCRYPTION_KEY=

# ── 管理员初始账号（首次启动自动创建）─────────────────────────
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── 数据库（Docker 部署必填）─────────────────────────────────
# 本地开发（非 Docker）取消注释并填真实值：
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/adobe
#
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── sherlockToken 铸造（fingerprint-chromium，已移除 RoxyBrowser）──
# Docker 一键部署：内置 mint 容器（headful + Xvfb）自动铸造，无需配置任何变量。
# 自建/远程铸造服务（本地开发或独立部署）：
# SHERLOCK_MINT_API=http://127.0.0.1:8777
#
# 本地开发替代方案（本进程直启 fingerprint-chromium）：
# 填本地 Chromium 二进制路径（macOS 从 dmg 拷出的 .app 二进制）。注意不要把路径指向
# 只读 dmg 卷（network service 会崩溃），要先拷贝到本地目录。
# FP_CHROME_BIN=/path/to/Chromium.app/Contents/MacOS/Chromium
# 默认有头铸造（实测 200 率远高于 headless）；headless 仅限调试场景：
# FP_CHROME_HEADLESS=0
# 铸造走直连（实测好 token 不挑铸造 IP，直连最快最稳）；关闭则从代理池随机取节点铸造。
# 重要：headless 时必须走「住宅代理」铸造（ark 组件反映铸造 IP 住宅度），否则 408。
# FP_MINT_DIRECT=0
