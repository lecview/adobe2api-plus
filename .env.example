# ───────────────────────────────────────────────────────────────
# adobe2api-plus 环境变量模板
#
# 一键部署（Docker）：
#   cp .env.example .env
#   填下方 SESSION_SECRET / ENCRYPTION_KEY（有生成命令）
#   docker compose up -d --build
#   数据库、表结构、管理员账号全部自动完成。
#
# 本地开发（非 Docker）：复制为 .env.development，并填写 DATABASE_URL。
# ───────────────────────────────────────────────────────────────

# ── 安全密钥（必填）───────────────────────────────────────────
# 会话签名密钥（≥32 字节）：openssl rand -hex 32
SESSION_SECRET=

# 凭据加密密钥（≥16 字节）：openssl rand -hex 16
ENCRYPTION_KEY=

# ── 管理员初始账号（首次启动自动创建）─────────────────────────
# 密码建议填写；留空时 Docker 部署回退为默认值 admin123（务必修改）
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ── 数据库（Docker 一键部署自动配置，无需填写）────────────────
# 本地开发（非 Docker）取消注释并填真实值：
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/adobe
#
# Docker 部署数据库账号（不填则默认：adobe / adobe，库名 adobe）
# MYSQL_ROOT_PASSWORD=adobe
# MYSQL_USER=adobe
# MYSQL_PASSWORD=adobe
# MYSQL_DATABASE=adobe

# ── Roxy 浏览器（sherlockToken 自动铸造；留空则走手动输入 token）──
# 只需 API 地址 + API Key。workspaceId / dirId 由程序自动获取/创建，无需配置。
ROXYBROWSER_API_BASE=http://127.0.0.1:50001
ROXYBROWSER_API_TOKEN=
# 容器内访问宿主机 CDP 时设置（如部署在 Docker 内）
# ROXYBROWSER_CDP_HOST=host.docker.internal
# 宿主机 sherlock 铸造服务地址（配置后优先走该服务，无需直连 CDP）
# ROXYBROWSER_MINT_API=http://127.0.0.1:50002
