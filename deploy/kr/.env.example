COMPOSE_PROJECT_NAME=aimasker-adobe2api-plus
DEPLOY_SHA=<full-git-commit-sha>
WEB_PORT=<free-loopback-port>
WEB_IMAGE=aimasker/adobe2api-plus-web:<full-git-commit-sha>
MINT_IMAGE=aimasker/adobe2api-plus-mint:<full-git-commit-sha>
MYSQL_IMAGE=mysql:8.0@sha256:<pinned-registry-digest>

MYSQL_DATABASE=adobe2api_plus
MYSQL_USER=adobe2api_plus
MYSQL_ROOT_PASSWORD=<strong-random-secret>
MYSQL_PASSWORD=<strong-random-secret>

SESSION_SECRET=<at-least-32-random-bytes>
ENCRYPTION_KEY=<64-hex-characters>
ADMIN_BOOTSTRAP_USERNAME=<non-default-admin-name>
ADMIN_BOOTSTRAP_PASSWORD=<strong-random-secret>
